APP_NAME="LPK Lombok Shorai Rinjani"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database (PostgreSQL Managed Blitz)
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=prefer
# Optional: if Blitz provides a single connection string URL
# DATABASE_URL=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Cache & Queue (Database Driven)
CACHE_STORE=database
QUEUE_CONNECTION=database

# File Storage (Local Private Storage for Learning Materials)
FILESYSTEM_DISK=local

# Broadcasting (Realtime WebSockets - null by default in initial API deploy)
BROADCAST_CONNECTION=null

# Mail (Optional / log by default)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="info@lpklombokshorairinjani.com"
MAIL_FROM_NAME="${APP_NAME}"

# Frontend URL & CORS Configuration (Vercel Frontend URL)
# Put the exact Vercel origin (https://<domain>, no trailing slash) in FRONTEND_URLS.
FRONTEND_URL=
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS_PATTERNS=

# Sanctum stateful domains: LEAVE UNSET/EMPTY.
# This app authenticates with Bearer tokens. Listing the frontend domain here
# makes Sanctum require a CSRF token and login will fail with HTTP 419.
# SANCTUM_STATEFUL_DOMAINS=

# Cloudflare Turnstile Anti-Bot Verification (Optional)
CLOUDFLARE_TURNSTILE_SITE_KEY=0x4AAAAAAFNhAGEWSMnKgca5
CLOUDFLARE_TURNSTILE_SECRET_KEY=0x4AAAAAAFNhAOqSQbgFlYg2Y8bJ_fFc1m8

# Google OAuth Authentication (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/auth/google/callback"

# Optional Laravel Reverb WebSockets (Leave blank unless Reverb is running)
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST=
# REVERB_PORT=443
# REVERB_SCHEME=https
